model AuditEngagement {
    id               String    @id @default(uuid())
    org_account_id   String
    account          Account   @relation(fields: [org_account_id], references: [id], onDelete: Cascade)
    ref              String
    title            String
    scope            String?
    status           String
    lead_auditor     String?
    priority_score   Int?
    findings_count   Int       @default(0)
    started_at       DateTime?
    closed_at        DateTime?
    ai_generated     Boolean   @default(false)
    is_edited        Boolean   @default(false)
    report_url       String?
    // #97: Three Lines of Defense classification. Audit engagements default
    // to 3rd line (internal audit itself), matching Fullbloom's per-entity
    // fallback — see risk.prisma's LineOfDefense enum for the full context.
    line_of_defense  LineOfDefense @default(THIRD)
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt

    // aexa-frontend#165: engagements link to real Risk records through an
    // explicit join table (below), replacing the former free-text
    // `linked_risk_refs String[]` tag column. The old column carried no format
    // convention and nothing clickable; it's dropped (not migrated) since the
    // feature only shipped this session and there's no structured data to move.
    risks AuditEngagementRisk[]

    // aexa-server#244: formal engagement<->finding link (see action.prisma's
    // auditEngagementId comment). findings_count above is no longer trusted
    // as client input — audit.service.ts now derives it server-side from
    // this relation's real count instead.
    findings Action[]

    @@index([org_account_id])
}

// aexa-frontend#165: explicit many-to-many between an AuditEngagement and the
// Risk records it covers. Modeled as a first-class join row (not an implicit
// Prisma relation) so it can hold its own columns/audit metadata later and so
// the org-scoped validation + delete guards can query it directly.
//
// Both FKs are onDelete: Cascade, so deleting either side tears down the link
// row (never the opposite entity). Note the interaction with the Risk in-use
// delete guard (issue #200-203, risk.service.ts): a risk still linked to any
// engagement is treated as *in use* and blocked from deletion with a 409,
// consistent with the conservative philosophy applied to inspections /
// recommendations / KRIs / live approval cycles — the audit↔risk association
// is meaningful audit-trail data ("which audits touch this risk", the exact
// queryability #165 is about), so it must not silently vanish on a risk
// delete; the caller unlinks the risk from its engagements first. The reverse
// direction has NO such block: deleting an engagement legitimately cascades
// away its own link rows (the risks survive), so audit deletion is unaffected.
model AuditEngagementRisk {
    id                String          @id @default(uuid())
    auditEngagementId String
    auditEngagement   AuditEngagement @relation(fields: [auditEngagementId], references: [id], onDelete: Cascade)
    riskId            String
    risk              Risk            @relation(fields: [riskId], references: [id], onDelete: Cascade)
    createdAt         DateTime        @default(now())

    @@unique([auditEngagementId, riskId])
    @@index([auditEngagementId])
    @@index([riskId])
}
