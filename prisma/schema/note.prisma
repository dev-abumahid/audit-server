model Note {
    id String @id @default(uuid())

    // body data
    title          String
    extracted_text String
    // The original file this note was extracted from (if any) — kept for
    // "I cannot visualize it" (see #54): previously extract_note_from_any_
    // file_or_image_and_save_into_db read the uploaded file, sent it to AI
    // for text extraction, and discarded it, so the source file itself was
    // never visible again after upload. Same shape as Action/Inspection
    // attachments.
    attachments    String[]         @default([])

    // foreign key
    orgAccountId String
    inspectionId String @unique

    // Relation
    orgAccount Account    @relation(fields: [orgAccountId], references: [id], onDelete: Cascade)
    inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([orgAccountId])
}
