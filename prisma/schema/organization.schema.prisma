// Slice 1 of issue #55 (team/org management). Additive-only: new models and
// enums plus optional back-relations on existing models. No service/route
// changes ship in this slice — see src/scripts/backfill-org-membership.ts
// for the one-time data migration that populates these tables for existing
// accounts.

enum OrgRole {
    ADMIN
    LEAD_AUDITOR
    LIGHT_USER
    VIEWER
}

enum OrgMemberStatus {
    ACTIVE
    SUSPENDED
}

enum FindingAssignmentStatus {
    PENDING_APPROVAL
    ACTIVE
    REJECTED
}

enum OrgInvitationStatus {
    PENDING
    ACCEPTED
    EXPIRED
}

model Organization {
    id   String @id @default(uuid())
    name String
    // The Account whose existing orgAccountId / org_account_id FKs represent
    // this org's data today (see CLAUDE.md org-scoping table).
    anchorAccountId String @unique

    requireApprovalForSubAssignment Boolean @default(false)
    // Configurable display label for the LEAD_AUDITOR role; the OrgRole enum
    // value itself stays fixed.
    leadAuditorRoleLabel String @default("Lead Auditor")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    members         OrgMember[]
    externalMembers ExternalOrgMember[]
    invitations     OrgInvitation[]
    auditLog        OrgAuditLog[]
}

model OrgMember {
    id             String @id @default(uuid())
    organizationId String
    // One active org per account, enforced here.
    accountId String @unique
    role      OrgRole
    status    OrgMemberStatus @default(ACTIVE)
    // Optional time-boxed access; null = no expiry.
    expiresAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

    inspectionAssignments        InspectionAssignment[]
    findingAssignmentsAsAssignee FindingAssignment[]    @relation("FindingAssigneeMember")

    @@index([organizationId])
}

// Reused for BOTH Lead Auditor's edit-scope assignment AND Viewer's optional
// visibility-scope assignment. An empty set of rows for a Viewer means
// org-wide visibility; a populated set means scoped-only. For Lead Auditor,
// rows are always populated (they never get org-wide access by default).
model InspectionAssignment {
    id           String @id @default(uuid())
    orgMemberId  String
    inspectionId String
    // accountId of whoever made the assignment.
    assignedById String
    // Soft-revoke instead of deleting the row: an auditor investigating a
    // disputed finding needs to be able to answer "who was assigned to this
    // inspection at the time, and who removed them, and when" — a hard
    // delete on unassign destroys that history. null = still assigned.
    revokedAt   DateTime?
    revokedById String?

    createdAt DateTime @default(now())

    orgMember  OrgMember  @relation(fields: [orgMemberId], references: [id], onDelete: Cascade)
    inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

    // Only one *active* (non-revoked) assignment per member/inspection pair —
    // a revoked one doesn't block re-assigning the same member later, so this
    // can't be a plain @@unique on the base columns. Enforced via a partial
    // unique index added by hand in the migration (see migration.sql);
    // Prisma's schema DSL has no WHERE-clause syntax for @@unique.
    @@index([inspectionId])
    @@index([orgMemberId])
}

model FindingAssignment {
    id                  String @id @default(uuid())
    actionId            String
    orgMemberId         String?
    externalOrgMemberId String?
    assignedById        String
    approvedById        String?
    status              FindingAssignmentStatus @default(PENDING_APPROVAL)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    action            Action             @relation(fields: [actionId], references: [id], onDelete: Cascade)
    orgMember         OrgMember?         @relation("FindingAssigneeMember", fields: [orgMemberId], references: [id], onDelete: Cascade)
    externalOrgMember ExternalOrgMember? @relation(fields: [externalOrgMemberId], references: [id], onDelete: Cascade)

    @@index([actionId])
    @@index([orgMemberId])
    @@index([externalOrgMemberId])
}

model OrgInvitation {
    id             String @id @default(uuid())
    organizationId String
    email          String
    role           OrgRole
    invitedById    String
    token          String @unique
    status         OrgInvitationStatus @default(PENDING)
    expiresAt      DateTime
    acceptedAt     DateTime?

    createdAt DateTime @default(now())

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@index([email])
}

// Lightweight identity for external LIGHT_USER or VIEWER members — NOT an
// Account row (no password, not in the ROLE enum, not part of the normal
// JWT auth flow). Scoped to exactly one Organization.
model ExternalOrgMember {
    id             String  @id @default(uuid())
    organizationId String
    email          String
    fullName       String?
    // LIGHT_USER or VIEWER only; enforced in application code, not the DB.
    role      OrgRole
    isActive  Boolean @default(true)
    expiresAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    organization       Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    findingAssignments FindingAssignment[]
    verificationCodes  ExternalOrgMemberVerificationCode[]

    @@unique([organizationId, email])
}

model ExternalOrgMemberVerificationCode {
    id                  String @id @default(uuid())
    externalOrgMemberId String
    // Hashed, never store plaintext.
    codeHash   String
    expiresAt  DateTime
    consumedAt DateTime?
    // Added ahead of slice 5's verify endpoint so the attempt-counter/lockout
    // requirement can't be missed when that endpoint gets built: a short
    // numeric OTP with no per-row attempt cap has no structural brute-force
    // resistance beyond whatever rate limiter happens to be wired to the
    // route. failedAttempts increments per wrong guess; lockedUntil is set
    // once a threshold is hit, independent of IP-based rate limiting.
    failedAttempts Int       @default(0)
    lockedUntil    DateTime?

    createdAt DateTime @default(now())

    externalOrgMember ExternalOrgMember @relation(fields: [externalOrgMemberId], references: [id], onDelete: Cascade)

    @@index([externalOrgMemberId])
}

// Durable, append-only record of org-membership lifecycle events. OrgMember/
// OrgInvitation only ever hold current-state columns (status, expiresAt) —
// without this table, "who suspended member X, and when, and who invited
// them in the first place beyond invitedById" is unanswerable once a status
// change overwrites the previous one. Compliance/audit product, so this
// matters beyond debugging convenience.
enum OrgAuditAction {
    MEMBER_INVITED
    MEMBER_INVITE_RESENT
    MEMBER_INVITE_ACCEPTED
    MEMBER_STATUS_CHANGED
    MEMBER_EXPIRY_CHANGED
    MEMBER_REMOVED
    INSPECTION_ASSIGNMENT_CREATED
    INSPECTION_ASSIGNMENT_REVOKED
}

model OrgAuditLog {
    id             String         @id @default(uuid())
    organizationId String
    action         OrgAuditAction
    // accountId of whoever performed the action. Null for actions with no
    // authenticated actor (e.g. a member accepting their own invitation is
    // captured via the subject fields below, not actorAccountId).
    actorAccountId String?
    // The OrgMember/OrgInvitation this event is about, where applicable.
    subjectOrgMemberId String?
    subjectEmail       String?
    // Freeform before/after snapshot for status/expiresAt-style changes —
    // deliberately loose (Json, not typed columns) since the set of fields
    // worth recording differs per action type.
    metadata Json?

    createdAt DateTime @default(now())

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@index([organizationId, createdAt])
    @@index([subjectOrgMemberId])
}
