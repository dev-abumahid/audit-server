enum PRIORITY {
    Low
    Medium
    High
}

enum STATUS {
    TO_DO
    IN_PROGRESS
    COMPLETE
    CANT_DO
}

// Slice-1 (#55) prep: distinguishes internal-only action messages from ones
// visible to external/client users. Schema-only for now — no enforcement
// logic exists yet, and the default keeps existing rows behaving exactly as
// before (internal-only).
enum MessageVisibility {
    INTERNAL
    CLIENT_VISIBLE
}

model Action {
    id String @id @default(uuid())

    // FK
    orgAccountId String
    inspectionId String
    siteId       String?
    questionId   String?

    // Optional back-link to the ComplianceObligation this action remediates
    // (aexa-frontend#166 "Create Action" from a non-compliant obligation).
    // A real FK, not a free-text tag — mirrors the parallel #165 decision to
    // model cross-module references as relations. It's a sparse, informational
    // link (most actions have no obligation), same shape as siteId/questionId
    // above.
    //
    // onDelete: SetNull (NOT Cascade like siteId/questionId/inspectionId):
    // an Action is a first-class remediation record that fully owns its
    // inspection, org, title, assignees and history. Losing the obligation it
    // once pointed at must not destroy that work — it should only drop the
    // now-dangling link, exactly the reasoning ComplianceObligation.site_id
    // already documents for its own SetNull. This also means deleting an
    // obligation with linked actions succeeds cleanly (the FKs null out) with
    // no service-level delete-guard needed — see delete_compliance_from_db;
    // the guard question was considered and deliberately declined because
    // SetNull orphans nothing meaningful here (aexa-frontend#166).
    complianceObligationId String?

    // Main body
    actionTitle String
    // Nullable -- matches templateDisc's String?/optional() convention, the
    // same "genuinely optional description" shape. Frontend labels this
    // "Description (Optional)" and never sends an empty string, only
    // undefined, when left blank.
    actionDisc  String?
    priority    PRIORITY
    dueDate     DateTime
    status      STATUS   @default(TO_DO)
    attachments String[] @default([])

    // Relation
    messages ActionMessage[]
    site     Site?           @relation(fields: [siteId], references: [id], onDelete: Cascade)
    question Question?       @relation(fields: [questionId], references: [id], onDelete: Cascade)
    inspection Inspection?     @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
    orgAccount Account?        @relation(fields: [orgAccountId], references: [id], onDelete: Cascade)
    complianceObligation ComplianceObligation? @relation(fields: [complianceObligationId], references: [id], onDelete: SetNull)

    // Date time
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Slice-1 (#55) prep
    findingAssignments FindingAssignment[]

    // "Assigned Responsible" — who's nominally on the hook for this
    // finding. Deliberately NOT FindingAssignment: that model is a real
    // access-control mechanism (Light User sub-assignment, approval-gated,
    // grants actual authority over the Action — see its own schema
    // comment). This is a plain informational tag any org member can carry,
    // set directly on finding creation/edit, no approval, no elevated
    // access implied. Conflating the two would silently grant real
    // authority to whoever's tagged here. (#52)
    responsibleAssignees ActionResponsible[]

    @@index([orgAccountId])
}

model ActionMessage {
    id String @id @default(uuid())

    // FK
    actionId        String
    senderAccountId String

    // Main body
    message    String
    fileUrl    String?
    visibility MessageVisibility @default(INTERNAL)

    // Relations
    action  Action  @relation(fields: [actionId], references: [id], onDelete: Cascade)
    account Account @relation(fields: [senderAccountId], references: [id], onDelete: Cascade)

    // Date time
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// A finding's assignee list is submitted as OrgMember ids, not Account ids
// — confirmed against aexa-frontend's actual GET /organization/members
// response shape (organization.service.ts's get_org_members_from_db only
// selects the top-level OrgMember.id, never account.id) and
// CreateNewFindingModal.tsx's checkbox `value`/`key`, both keyed off
// `user.id` from that same response. onDelete: Cascade on orgMember is
// deliberate and safe here — it only removes this join row when a member
// leaves the org, not the Action itself (that would need onDelete on the
// `action` relation, which stays Cascade only from Action's own deletion).
model ActionResponsible {
    id          String @id @default(uuid())
    actionId    String
    orgMemberId String

    createdAt DateTime @default(now())

    action    Action    @relation(fields: [actionId], references: [id], onDelete: Cascade)
    orgMember OrgMember @relation(fields: [orgMemberId], references: [id], onDelete: Cascade)

    @@unique([actionId, orgMemberId])
    @@index([orgMemberId])
}
