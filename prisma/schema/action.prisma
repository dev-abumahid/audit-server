enum PRIORITY {
    Low
    Medium
    High
}

enum STATUS {
    TO_DO
    IN_PROGRESS
    COMPLETE
    CANT_DO
}

// Slice-1 (#55) prep: distinguishes internal-only action messages from ones
// visible to external/client users. Schema-only for now — no enforcement
// logic exists yet, and the default keeps existing rows behaving exactly as
// before (internal-only).
enum MessageVisibility {
    INTERNAL
    CLIENT_VISIBLE
}

model Action {
    id String @id @default(uuid())

    // FK
    orgAccountId String
    inspectionId String
    siteId       String?
    questionId   String?

    // Optional back-link to the ComplianceObligation this action remediates
    // (aexa-frontend#166 "Create Action" from a non-compliant obligation).
    // A real FK, not a free-text tag — mirrors the parallel #165 decision to
    // model cross-module references as relations. It's a sparse, informational
    // link (most actions have no obligation), same shape as siteId/questionId
    // above.
    //
    // onDelete: SetNull (NOT Cascade like siteId/questionId/inspectionId):
    // an Action is a first-class remediation record that fully owns its
    // inspection, org, title, assignees and history. Losing the obligation it
    // once pointed at must not destroy that work — it should only drop the
    // now-dangling link, exactly the reasoning ComplianceObligation.site_id
    // already documents for its own SetNull. This also means deleting an
    // obligation with linked actions succeeds cleanly (the FKs null out) with
    // no service-level delete-guard needed — see delete_compliance_from_db;
    // the guard question was considered and deliberately declined because
    // SetNull orphans nothing meaningful here (aexa-frontend#166).
    complianceObligationId String?

    // aexa-server#244: formal engagement<->finding link. Findings previously
    // hung off Inspections only, with no way to query "which findings belong
    // to this AuditEngagement" — AuditEngagement.findings_count was a plain
    // number an admin manually typed into the engagement form, never derived
    // from any real query. Same shape/rationale as complianceObligationId
    // above: a sparse, informational, set-once-at-creation link (see
    // action.service.ts's create_action_into_db/update_action_into_db —
    // deliberately not part of the update-writable field set, same as
    // complianceObligationId), onDelete: SetNull for the same reason (an
    // Action fully owns its own remediation record; losing the engagement it
    // once pointed at must not destroy that work).
    auditEngagementId String?

    // Main body
    actionTitle String
    // Nullable -- matches templateDisc's String?/optional() convention, the
    // same "genuinely optional description" shape. Frontend labels this
    // "Description (Optional)" and never sends an empty string, only
    // undefined, when left blank.
    actionDisc  String?
    priority    PRIORITY
    dueDate     DateTime
    status      STATUS   @default(TO_DO)
    attachments String[] @default([])

    // aexa-server#244: IIA's "Five Cs" (Criteria, Condition, Cause,
    // Consequence/Effect, Corrective Action) for a defensible finding record
    // — actionTitle/actionDisc/priority/dueDate above already serve as the
    // Corrective Action; these four were previously entirely absent, so
    // Action was a task tracker (title + free-text description + priority)
    // rather than a structured finding. All nullable/optional: this is a
    // live table with existing rows, and the ticket's own framing left
    // "required vs optional" an open product decision — optional is the only
    // choice that doesn't force every existing Action through a migration or
    // block a PATCH that doesn't touch these fields (same reasoning as
    // line_of_defense's DB-nullable/app-required-on-create split above,
    // except these aren't even required on create — see action.validation.ts
    // for why: unlike line_of_defense, there's no clean "must classify
    // every new finding" argument here, since plenty of legitimate Actions
    // are still plain remediation tasks, not formal audit findings).
    //
    // Deliberately NOT unified with RecommendationResult's
    // observation/standard/recommendation (condition/criteria/corrective-
    // action) or IntelligenceItem.root_cause in this change — reconciling
    // those partial precedents into one model is a real migration decision
    // (which table wins, how to backfill), scoped out as a separate,
    // dedicated follow-up rather than bundled in silently here.
    criteria  String?
    condition String?
    cause     String?
    effect    String?

    // #97 (Three Lines of Defense): deliberately nullable with NO default,
    // unlike the other 4 models this classification was added to (Risk,
    // Kri, ComplianceObligation, AuditEngagement all get a sensible
    // per-entity-type default — see risk.prisma's LineOfDefense enum). An
    // Action covers two very different roles — remediation work (1st-line-
    // like) and audit findings (3rd-line-like) — so any single default would
    // misclassify roughly half of them; the user must pick explicitly.
    //
    // This is a live production table, so the column itself CANNOT be
    // NOT NULL: a hard constraint would fail the migration against every
    // existing row (they have no line_of_defense opinion recorded, and there
    // is no correct value to backfill them with). The migration leaves
    // existing rows NULL, surfaced in the UI as an "Unclassified" bucket.
    //
    // The requirement lives one layer up instead: action.validation.ts's
    // create_action schema makes `line_of_defense` required (not optional)
    // for any NEW Action going forward, while update_action keeps it
    // optional so existing untouched Actions are never forced through a
    // migration just to satisfy a PATCH. This DB-nullable /
    // app-required-on-create split is intentional, not an oversight.
    line_of_defense LineOfDefense?

    // aexa-frontend#191: "Send to Finding" promotes an AI root-cause bucket's
    // groupedAction into a real Action, same provenance-flag convention
    // Risk/Kri/ComplianceObligation/AuditEngagement already use (see
    // risk.prisma's ai_generated/is_edited pair) -- Action had neither field
    // until now because no AI flow wrote an Action directly before this one.
    // is_edited flips to true the first time a human edits an AI-created
    // Action, same as risk.service.ts's convention for Risk (not enforced by
    // this migration -- update_action_into_db doesn't set it yet, mirroring
    // that Risk's own update path was the one that added that behavior, out
    // of scope for this endpoint-only PR).
    ai_generated Boolean @default(false)
    is_edited    Boolean @default(false)

    // Relation
    messages ActionMessage[]
    site     Site?           @relation(fields: [siteId], references: [id], onDelete: Cascade)
    question Question?       @relation(fields: [questionId], references: [id], onDelete: Cascade)
    inspection Inspection?     @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
    orgAccount Account?        @relation(fields: [orgAccountId], references: [id], onDelete: Cascade)
    complianceObligation ComplianceObligation? @relation(fields: [complianceObligationId], references: [id], onDelete: SetNull)
    auditEngagement AuditEngagement? @relation(fields: [auditEngagementId], references: [id], onDelete: SetNull)

    // Date time
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Slice-1 (#55) prep
    findingAssignments FindingAssignment[]

    // aexa-server#252: finding closure maker-checker workflow.
    closureApprovals ActionClosureApproval[]

    // "Assigned Responsible" — who's nominally on the hook for this
    // finding. Deliberately NOT FindingAssignment: that model is a real
    // access-control mechanism (Light User sub-assignment, approval-gated,
    // grants actual authority over the Action — see its own schema
    // comment). This is a plain informational tag any org member can carry,
    // set directly on finding creation/edit, no approval, no elevated
    // access implied. Conflating the two would silently grant real
    // authority to whoever's tagged here. (#52)
    responsibleAssignees ActionResponsible[]

    @@index([orgAccountId])
    // aexa-server#244: audit.service.ts's attachFindingsCounts groupBys/
    // filters on this column (unlike complianceObligationId, which has no
    // analogous counting query yet) — a real, newly-added query pattern
    // this index directly serves.
    @@index([auditEngagementId])
}

model ActionMessage {
    id String @id @default(uuid())

    // FK
    actionId        String
    senderAccountId String

    // Main body
    message    String
    fileUrl    String?
    visibility MessageVisibility @default(INTERNAL)

    // Relations
    action  Action  @relation(fields: [actionId], references: [id], onDelete: Cascade)
    account Account @relation(fields: [senderAccountId], references: [id], onDelete: Cascade)

    // Date time
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// A finding's assignee list is submitted as OrgMember ids, not Account ids
// — confirmed against aexa-frontend's actual GET /organization/members
// response shape (organization.service.ts's get_org_members_from_db only
// selects the top-level OrgMember.id, never account.id) and
// CreateNewFindingModal.tsx's checkbox `value`/`key`, both keyed off
// `user.id` from that same response. onDelete: Cascade on orgMember is
// deliberate and safe here — it only removes this join row when a member
// leaves the org, not the Action itself (that would need onDelete on the
// `action` relation, which stays Cascade only from Action's own deletion).
model ActionResponsible {
    id          String @id @default(uuid())
    actionId    String
    orgMemberId String

    createdAt DateTime @default(now())

    action    Action    @relation(fields: [actionId], references: [id], onDelete: Cascade)
    orgMember OrgMember @relation(fields: [orgMemberId], references: [id], onDelete: Cascade)

    @@unique([actionId, orgMemberId])
    @@index([orgMemberId])
}

// aexa-server#252 — finding closure maker-checker workflow. IIA Standard
// 2500.A1 requires a follow-up process ensuring corrective actions were
// effectively implemented (or that risk was formally accepted), not a
// self-report — previously update_action_into_db wrote `status` with no
// state-machine at all, and a Light User sub-assigned to a finding could
// mark it COMPLETE themselves with no independent check.
//
// Structural twin of RiskApproval (risk.prisma) — same submit -> pending ->
// approve/reject shape, same invalidatedAt soft-supersede-on-edit, same
// "at most one live cycle" partial unique index (see this migration's raw
// SQL, no Prisma DSL equivalent). The one addition: `requestedStatus`,
// since a finding's closure cycle must record WHICH terminal status
// (COMPLETE or CANT_DO) is being requested — RiskApproval has no
// equivalent because a Risk's operational status isn't gated by its
// approval cycle the way Action.status now is for its two terminal values.
//
// CANT_DO (risk acceptance, 2500.A1's other outcome) deliberately shares
// this exact flow rather than a separate lighter-weight one — no compelling
// reason surfaced to treat "management accepted the risk" as needing less
// rigor than "the remediation was verified effective".
enum ActionClosureApprovalStatus {
    PENDING_APPROVAL
    APPROVED
    REJECTED
}

model ActionClosureApproval {
    id       String @id @default(uuid())
    actionId String
    action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

    status ActionClosureApprovalStatus @default(PENDING_APPROVAL)
    // The terminal status this cycle is requesting — COMPLETE or CANT_DO.
    // Only applied to Action.status once this cycle is APPROVED (see
    // action.closure.service.ts's approve_action_closure).
    requestedStatus STATUS

    // accountId of whoever submitted the closure request. Plain string,
    // mirroring RiskApproval.submittedById.
    submittedById String
    // accountId of the ADMIN/LEAD_AUDITOR who approved/rejected; null while
    // pending. Maker-checker separation (action.closure.service.ts):
    // decidedById can never equal submittedById for the same cycle.
    decidedById String?
    decidedAt   DateTime?
    // Required on REJECTED so the reviewer's reason travels back to the
    // submitter, same precedent as RiskApproval.decisionNote.
    decisionNote String?

    // Soft-supersede: editing the finding after a cycle started sets
    // invalidatedAt, forcing a resubmission — the content being closed has
    // changed, so the prior verification no longer reflects reality. Same
    // shape as RiskApproval.invalidatedAt.
    invalidatedAt   DateTime?
    invalidatedById String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([actionId])
    @@index([status])
}
