model Risk {
    id                    String   @id @default(uuid())
    org_account_id        String
    account               Account  @relation(fields: [org_account_id], references: [id])
    name                  String
    description           String?
    category              String
    inherent_score        Int?
    residual_score        Int?
    pagerank_score        Int?
    financial_impact_min  Int?
    financial_impact_max  Int?
    probability           Int?
    velocity              String?
    trend                 String?
    status                String
    ai_generated          Boolean  @default(false)
    is_edited             Boolean  @default(false)
    site_id               String
    site                  Site     @relation(fields: [site_id], references: [id], onDelete: Cascade)
    source_info           String?
    control_design_eff    Int?
    control_operating_eff Int?
    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt

    // Relations
    inspections     Inspection[]
    templates       Template[]
    recommendations Recommendation[]

    @@index([org_account_id])
}
