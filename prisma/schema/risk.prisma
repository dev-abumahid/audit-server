// Issue #97 ("Three Lines of Defense" governance classification), mirroring
// the Fullbloom reference (ThreeLinesOfDefensePage.tsx)'s per-entity-type
// default: a Risk is operational/management-owned by default, i.e. 1st line.
// See action.prisma's LineOfDefense-related comment on Action for why that
// model is the one deliberate exception (nullable, no default) among the 5
// entities this classification was added to.
// aexa-frontend#208: GOVERNING_BODY added on top of the original three
// values above. The 2020 IIA Three Lines Model's headline structural
// addition over the 2013 version (which #97/#206 modeled) is an explicit
// governing body sitting above the three lines — the enum only had
// FIRST/SECOND/THIRD before this, with no governing-body concept anywhere.
// No existing model's default changes: this is purely an additional
// explicit selection for an entity that genuinely sits at governing-body
// oversight (e.g. a board-mandated audit engagement, or a risk formally
// accepted by the board). See org_scope.ts's
// assertCanReassignLineOfDefense for the companion third-line-independence
// permission fix from the same ticket.
enum LineOfDefense {
    FIRST
    SECOND
    THIRD
    GOVERNING_BODY
}

// design-docs/site-ai-risk-register-generation.md §3. Replaces a flawed
// binary "Nature: mandatory/voluntary" -- research surfaced real
// intermediate states a simple boolean can't represent (e.g. NIS 2 is real
// law but not yet transposed in France; Sapin II is real law but gated
// behind an employee/revenue threshold; APSAD/NF C 18-510 are private
// standards, not law at all). A derived "Mandatory/Voluntary" UI badge maps
// active/pending/conditional -> Mandatory and recognized_standard/voluntary
// -> Voluntary; that derivation lives in the frontend, not as a second
// stored field, so the two can never drift out of sync.
enum LegalStatus {
    active_statutory
    pending_statutory
    conditional_statutory
    recognized_standard
    voluntary_best_practice
}

// docs/design-docs/ai-risk-review-approval-workflow.md. Deliberately NOT
// named RiskApprovalStatus/approval_status -- that vocabulary is already
// taken by the unrelated maker-checker sign-off workflow below
// (RiskApprovalStatus, RiskApproval model): is this risk's *assessment*
// correct and final. This enum answers a different question: does this
// risk-register entry exist as a confirmed entry at all yet, or is it an
// unreviewed AI suggestion. A risk must be APPROVED here before it can be
// submitted into the separate RiskApprovalStatus flow (see
// risk.approval.service.ts).
enum RiskReviewStatus {
    APPROVED
    PENDING_REVIEW
    DISMISSED
}

// design-docs/site-ai-risk-register-generation.md §3. Both the GRC and UX
// design reviews independently flagged this as the single most important
// trust signal on an AI-generated risk -- must be a persisted, queryable
// field (not derived client-side) so it survives as a permanent marker on
// the Risk detail view after import, not just during the review step.
enum CitationConfidence {
    curated_verified
    ai_estimate
    none
}

// design-docs/site-ai-risk-register-generation.md's follow-on external-data-
// anchoring plan (Phase 0a). Deliberately distinct from CitationConfidence
// above: that field only ever describes the regulatory-citation dimension of
// a risk (does the cited framework resolve). SourceType is the general
// trust signal for the risk itself -- is ANY part of it (title, framing,
// financial-impact range) actually grounded in a real external fact, or
// purely the model's own reasoning. `anchored` requires a real,
// non-empty source_reference; `estimated` is the safe default for every
// pre-existing row and for anything the generation pipeline can't yet back
// with a verified source.
enum SourceType {
    anchored
    estimated
}

model Risk {
    id                    String   @id @default(uuid())
    org_account_id        String
    account               Account  @relation(fields: [org_account_id], references: [id], onDelete: Cascade)
    // aexa-frontend#142: human-readable reference code (e.g. "CYB-001"),
    // mirroring Fullbloom's Risk.ref. Generated at creation time
    // (see risk_ref.ts's generateRiskRef) from a category-derived prefix +
    // a zero-padded sequence scoped per (org_account_id, prefix) — see
    // risk_ref.ts for the full category->prefix map and fallback rule.
    // NOT NULL: every pre-existing row was backfilled by this migration's
    // raw SQL (see the migration file) using the identical scheme, so
    // there's no "can't backfill" gap the way action.prisma's
    // line_of_defense has for Action.
    ref                   String
    name                  String
    description           String?
    category              String
    // aexa-server#247: derived by default from probability x impact when
    // both are known (see risk_scoring.ts's computeInherentScore) — same
    // derive-with-override-and-staleness pattern as residual_score below.
    // Falls back to whatever raw value is supplied when probability/impact
    // aren't both present (the AI-onboarding and intelligence-promotion
    // producers don't collect `impact` yet, so this is a no-op there —
    // see risk_scoring.ts's file comment).
    inherent_score        Int?
    inherent_is_override     Boolean   @default(false)
    inherent_override_reason String?
    inherent_overridden_by   String?
    inherent_overridden_at   DateTime?
    inherent_override_stale  Boolean   @default(false)
    residual_score        Int?
    pagerank_score        Int?
    financial_impact_min  Int?
    financial_impact_max  Int?
    probability           Int?
    // aexa-server#241: the risk matrix's likelihood x impact axes weren't
    // actually independent — "impact" was faked from inherent_score (see
    // #202). This is the real, separately-collected impact measurement
    // (0-100, same scale as probability/inherent_score). Deliberately NOT
    // wired back into inherent_score's own value in this change — see
    // risk_scoring.ts's file comment for why that's scoped out.
    impact                Int?
    velocity              String?
    trend                 String?
    status                String
    ai_generated          Boolean  @default(false)
    is_edited             Boolean  @default(false)
    site_id               String
    site                  Site     @relation(fields: [site_id], references: [id], onDelete: Cascade)
    source_info           String?
    control_design_eff    Int?
    control_operating_eff Int?
    // aexa-server#241: residual_score is now DERIVED from inherent_score and
    // the two control-effectiveness fields above by default (see
    // risk_scoring.ts). These columns track the derived-with-override
    // pattern (mirrors ServiceNow IRM's real behavior, confirmed during
    // research for this ticket): a manual override is still allowed but
    // requires a reason, and an edit to any of the underlying inputs after
    // an override was set marks it "stale" (needs re-confirmation) rather
    // than silently discarding it.
    residual_is_override     Boolean   @default(false)
    residual_override_reason String?
    residual_overridden_by   String?
    residual_overridden_at   DateTime?
    residual_override_stale  Boolean   @default(false)
    // #97: which IIA "line of defense" owns this item. Risk defaults to 1st
    // line (operational/management-owned), matching Fullbloom's per-entity
    // fallback.
    line_of_defense       LineOfDefense @default(FIRST)
    // aexa-server#347: EBITDA-at-risk, per the CEO's proposed methodology
    // (CA du site x Marge EBITDA benchmark x Probabilite x Severite -- see
    // ebitda_risk.ts for the full formula/mapping writeup). Same
    // derived-with-override-and-staleness shape as inherent/residual_score
    // above: auto-computed from Site.revenue/activity + probability/impact
    // by default, but the benchmark margin is user-overridable (becomes the
    // org's "real" EBITDA margin per the ticket's "devient l'EBITDA reel").
    // ebitda_benchmark_sector stores the matched sector_benchmarks.ts key
    // (or the sector the override was made FROM); ebitda_benchmark_margin
    // is the 0-1 fraction actually used (benchmark or overridden).
    ebitda_at_risk           Int?
    ebitda_benchmark_sector  String?
    ebitda_benchmark_margin  Float?
    ebitda_is_override       Boolean   @default(false)
    ebitda_override_reason   String?
    ebitda_overridden_by     String?
    ebitda_overridden_at     DateTime?
    ebitda_override_stale    Boolean   @default(false)

    // design-docs/site-ai-risk-register-generation.md §3 -- new fields for
    // the AI risk-register generation feature. All nullable: unrelated to
    // this feature for any hand-created or pre-existing risk.
    legal_status              LegalStatus?
    regulatory_framework_id   String?
    // Restrict, not SetNull -- citation_confidence is designed to be a
    // permanent, never-drifting trust signal (see the field's own comment
    // below); a hard delete of a cited RegulatoryFramework silently
    // orphaning regulatory_framework_id while citation_confidence stays
    // "curated_verified" is exactly the drift that field was designed to
    // prevent. Restrict forces an explicit reassignment/downgrade flow at
    // the application layer before a cited framework can be removed
    // (review finding, PR #369).
    regulatoryFramework       RegulatoryFramework? @relation(fields: [regulatory_framework_id], references: [id], onDelete: Restrict)
    // Fallback citation text for a defensible-but-uncurated regulatory
    // reference (e.g. a live-search result from the existing Regulatory
    // Coverage feature's on-demand "find citation" action) -- never a
    // fabricated article number; general framing only if uncertain.
    regulatory_citation_note String?
    citation_confidence       CitationConfidence?
    // AI-suggested role hint (e.g. "HSE Manager"), not a real user FK --
    // deliberate scope decision, see design doc §3.
    internal_pilot            String?
    ai_generation_run_id      String?
    aiGenerationRun           AiRiskAnalysisRun? @relation(fields: [ai_generation_run_id], references: [id], onDelete: SetNull)

    // External-data-anchoring plan, Phase 0a. Non-nullable with a default so
    // every existing row and every future insert that doesn't set it
    // explicitly reads as `estimated` rather than leaving a trust gap. Set
    // to `anchored` today only when persistGeneratedRisk resolves a real
    // curated regulatory citation (see CitationConfidence.curated_verified
    // above) -- true external-source anchoring (SEC EDGAR, Eurostat, etc.)
    // lands in later phases and will set this the same way once those
    // integrations exist.
    source_type               SourceType @default(estimated)
    // Populated only when source_type = anchored: for a citation-backed
    // risk, RegulatoryFramework.official_reference; for future
    // external-source-backed risks, a source-specific reference (a CVE ID,
    // a docket number, an EDGAR CIK, etc. -- see the source-reference
    // validator-registry design in the external-data-anchoring plan).
    // Deliberately NOT required to be non-empty by a DB constraint --
    // enforced instead at the application layer in persistGeneratedRisk,
    // since the valid shape differs per source and isn't expressible as a
    // single CHECK.
    source_reference          String?
    // Sub-type within `category`, from the anchoring plan's per-category
    // checklist (e.g. "Ransomware" under "cyber"). Nullable: not populated
    // until the generation prompt/schema actually carries a checklist to
    // select from (later phase); existing categories have no such checklist
    // today.
    sous_type                 String?

    // docs/design-docs/ai-risk-review-approval-workflow.md. Defaults to
    // APPROVED for manually-created risks (a human wrote it directly, no
    // review needed) and every pre-existing row as of this migration
    // (backfill matches the prior design's contract: AI risks already
    // wrote straight into the confirmed register). AI-generated risks are
    // set to PENDING_REVIEW explicitly at creation time in
    // persistGeneratedRisk, not relying on this default.
    review_status              RiskReviewStatus @default(APPROVED)

    // Re-run/staleness fix: when a re-analysis run's fuzzy-dedup match
    // (isDuplicateOfExistingRisk in aiRiskAnalysis.service.ts) finds a risk
    // that already exists, the old behavior silently skipped creating the
    // new one -- a stale external citation (SEC/EPA/Eurostat data) then
    // sat untouched forever. Now the new risk is created and this old
    // row's supersededAt/supersededByRiskId are set instead, in the same
    // transaction. The row is NEVER deleted or hidden from its own detail
    // page -- only excluded from "current risk" list/aggregate/dashboard
    // views by a default `supersededAt: null` filter, same soft-supersede
    // shape RiskApproval.invalidatedAt/invalidatedById already uses.
    // SetNull (not Restrict/Cascade): deleting the superseding risk should
    // never block deletion or destroy the superseded row's own audit
    // trail -- it just loses the forward pointer.
    supersededAt           DateTime?
    supersededByRiskId     String?
    supersededBy           Risk?     @relation("RiskSupersession", fields: [supersededByRiskId], references: [id], onDelete: SetNull)
    supersededRisks        Risk[]    @relation("RiskSupersession")

    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt

    // Relations
    inspections     Inspection[]
    templates       Template[]
    recommendations Recommendation[]
    kris            Kri[]
    approvals       RiskApproval[]
    // Multi-line review coverage -- see line_of_defense_review.prisma's file
    // comment for why this is separate from the line_of_defense ownership
    // field above.
    lineReviews     RiskLineReview[]
    // aexa-frontend#165: engagements that cover this risk (explicit M2M join,
    // AuditEngagementRisk in audit.prisma). A risk with live links here is
    // blocked from deletion by the in-use guard in risk.service.ts.
    auditEngagements AuditEngagementRisk[]
    // aexa-frontend#141 stage 2: IntelligenceItems promoted into this Risk via
    // POST /intelligence/items/:id/create-risk. A Risk can have zero or more
    // originating IntelligenceItems (the FK lives on IntelligenceItem, not
    // here — see intelligence.prisma's created_risk_id/onDelete: SetNull
    // reasoning).
    intelligenceItems IntelligenceItem[]
    // aexa-server#346: ComplianceObligations optionally linked to this Risk,
    // either via POST /compliance/obligations/:id/create-risk (promotion,
    // same shape as intelligenceItems above) or
    // POST /compliance/obligations/:id/link-risk (attaches an existing
    // Risk). FK lives on ComplianceObligation (see compliance.prisma's
    // risk_id/onDelete: SetNull reasoning), so a Risk can have zero or more
    // linked obligations here.
    complianceObligations ComplianceObligation[]
    // aexa-frontend#142: risk-to-risk causal links pointing AT this risk by
    // ref (source_ref/target_ref reference Risk.ref, not Risk.id — see
    // RiskLink's own comment for why). No formal Prisma relation is declared
    // here because RiskLink's FKs are plain strings, not a real relation to
    // this model (matches Fullbloom's own design exactly).

    @@index([org_account_id])
    // aexa-frontend#142: refs are human-readable identifiers scoped to one
    // org, not globally unique — two orgs can both have a "CYB-001".
    @@unique([org_account_id, ref])
    @@index([regulatory_framework_id])
    @@index([ai_generation_run_id])
    // Register listing and several filtered read paths query by both
    // together on every load (see the design doc's filtering table).
    @@index([org_account_id, review_status])
    @@index([supersededByRiskId])
    // Nearly every "current risk" list/aggregate/dashboard read path now
    // filters org_account_id + supersededAt: null together -- same
    // reasoning as the review_status composite index above.
    @@index([org_account_id, supersededAt])
}

// aexa-frontend#142 — explicit risk-to-risk relationship table, mirroring
// Fullbloom's RiskLink model exactly (src/shared/types/domain.ts:
// `{ id, organization_id, source_ref, target_ref, link_type, ... }`).
// Confirmed against the real Fullbloom file: link_type is one of CAUSES,
// AMPLIFIES, CORRELATES (not "REVELE" — that string appears in Fullbloom's
// codebase, but on AuditFinding.link_type, a separate free-text field
// describing how a finding *reveals* a risk, not on RiskLink at all).
enum RiskLinkType {
    CAUSES
    AMPLIFIES
    CORRELATES
}

model RiskLink {
    id             String   @id @default(uuid())
    org_account_id String
    account        Account  @relation(fields: [org_account_id], references: [id], onDelete: Cascade)

    // Deliberately plain strings, NOT `@relation` foreign keys to Risk.id.
    // This mirrors Fullbloom's own RiskLink design (it references risks by
    // `ref`, not by their Supabase row id) and is the reason issue #142's
    // brief asked for it to be modeled this way rather than reworking the
    // frontend to correlate on UUIDs: a human-readable ref makes the link
    // table itself legible (an auditor can read "CYB-001 CAUSES OPS-004"
    // straight out of an export or a support ticket without a join), and it
    // keeps a link portable across a Risk being recreated/re-imported with a
    // new id but the same ref. The tradeoff — these two columns can't be
    // enforced as real FKs — is deliberately paid for with application-level
    // validation instead (see risk_link.service.ts: both refs must resolve
    // to a real, org-scoped Risk row, checked on every create).
    source_ref String
    target_ref String

    link_type RiskLinkType

    createdAt DateTime @default(now())

    @@unique([org_account_id, source_ref, target_ref, link_type])
    @@index([org_account_id])
    @@index([org_account_id, source_ref])
    @@index([org_account_id, target_ref])
}

// Maker-checker approval state for a risk's CURRENT assessment, closing
// aexa-frontend#95. Structurally mirrors FindingAssignment (issue #55 slice 4,
// organization.schema.prisma): a dedicated table (not columns bolted onto
// Risk, not a generic polymorphic engine) whose status enum drives an
// admin-only approval gate with a full OrgAuditLog trail.
//
// Deliberately SEPARATE from the operational `Risk.status` string
// (open/in_progress/completed/closed): approval state answers "has the current
// version of this risk's assessment been reviewed and signed off", which is an
// orthogonal concept to where the risk sits in its operational lifecycle.
//
// State machine: a LEAD_AUDITOR (or ADMIN) submits -> PENDING_APPROVAL; an
// ADMIN approves -> APPROVED or rejects -> REJECTED. Editing a risk that has a
// live PENDING_APPROVAL/APPROVED cycle invalidates it (invalidatedAt set) —
// the reviewed version is stale, so a fresh submission is required. A REJECTED
// or invalidated row never blocks a new submission, enforced by a partial
// unique index in the migration (one live, non-rejected cycle per risk).
enum RiskApprovalStatus {
    PENDING_APPROVAL
    APPROVED
    REJECTED
}

model RiskApproval {
    id     String @id @default(uuid())
    riskId String
    risk   Risk   @relation(fields: [riskId], references: [id], onDelete: Cascade)

    status RiskApprovalStatus @default(PENDING_APPROVAL)
    // accountId of the LEAD_AUDITOR/ADMIN who submitted the assessment for
    // approval. Plain string, mirroring FindingAssignment.assignedById (not an
    // Account FK).
    submittedById String
    // accountId of the ADMIN who approved/rejected; null while pending.
    decidedById String?
    decidedAt   DateTime?
    // Required on REJECTED so the reviewer's reason travels back to the
    // submitter ("returns with questions", Archer precedent); null otherwise.
    decisionNote String?

    // Soft-supersede, same shape as FindingAssignment.revokedAt: an edit to the
    // risk after this cycle started sets invalidatedAt, forcing a resubmission.
    // Also the analog of FindingAssignment's "revoked-while-pending" edge case
    // — approve/reject must reject an already-invalidated pending row.
    invalidatedAt   DateTime?
    invalidatedById String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([riskId])
    @@index([status])
}

// design-docs/site-ai-risk-register-generation.md §3/§5. Curated,
// human-verified regulatory reference the AI risk-generation prompt must
// cite FROM (never invent a law/article number) -- DB-backed rather than a
// static config file so it's admin-editable without a deploy and carries a
// real audit trail (who changed what, when), since a customer's own
// auditor may eventually ask why Qiyrix believes a given citation applies.
// Global/shared across all orgs, not org-scoped -- these are real laws, not
// tenant data.
model RegulatoryFramework {
    id                 String       @id @default(uuid())
    name               String
    official_reference String
    jurisdiction       String
    domain             String
    legal_status       LegalStatus
    // Structured threshold, e.g. {"min_employees": 500,
    // "min_revenue_eur": 100000000} for Sapin II, or
    // {"min_employees_france": 5000, "min_employees_worldwide": 10000} for
    // Devoir de Vigilance. Null for universal frameworks (DUERP, RGPD).
    // Consumed by the deterministic threshold check (design doc §10) --
    // never trust the AI's own applicability judgment for a
    // threshold-bearing framework.
    applicability_threshold Json?
    summary            String
    source_url         String?
    last_verified_at   DateTime
    updated_by         String?
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    risks Risk[]

    // Prevents a re-run seed script or an admin re-adding an entry from
    // silently duplicating a curated framework -- since Phase 2 embeds the
    // ENTIRE table verbatim into every generation call (design doc §4/§7),
    // a duplicate wouldn't just be bad data, it'd pollute every prompt and
    // break the byte-identical-prefix requirement the prompt-caching design
    // depends on (review finding, PR #369).
    @@unique([official_reference])
    @@index([legal_status])
    @@index([domain])
}

enum AiRiskAnalysisRunStatus {
    running
    completed
    partial
    failed
}

// design-docs/site-ai-risk-register-generation.md §3/§6. Provenance record
// for one "Analyze with AI" click -- so a permanent link survives past the
// review step (a future auditor needs to be able to tell "we manually
// assessed this" from "AI suggested this and we accepted it," months
// later), and so Phase 2's per-category pending/success/failed state has
// somewhere to live for the progressive-results polling UI (design doc §6).
model AiRiskAnalysisRun {
    id                     String   @id @default(uuid())
    site_id                String
    site                   Site     @relation(fields: [site_id], references: [id], onDelete: Cascade)
    org_account_id         String
    account                Account  @relation(fields: [org_account_id], references: [id], onDelete: Cascade)
    triggered_by_account_id String

    status      AiRiskAnalysisRunStatus @default(running)
    started_at  DateTime                @default(now())
    completed_at DateTime?

    // Phase 1 triage output, kept for auditability -- which categories were
    // judged applicable/not and why, before Phase 2 ever ran.
    triage_result         Json?
    categories_applicable  Json?
    // [{category, reasoning}, ...] -- categories triage judged inapplicable.
    categories_skipped     Json?
    // [{category, error}, ...] -- categories whose Phase 2 call failed after
    // retry; surfaced explicitly in the UI, never silently dropped (design
    // doc §7).
    categories_failed      Json?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    risks Risk[]

    @@index([site_id])
    @@index([org_account_id])
    @@index([status])
}
