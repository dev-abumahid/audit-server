enum ROLE {
    ADMIN
    USER
    ORGANIZATION
}

enum PROVIDER {
    LOCAL
    GOOGLE
    FACEBOOK
    GITHUB
    TWITTER
    LINKEDIN
    INSTAGRAM
}

model Account {
    id                 String    @id @default(uuid())
    email              String    @unique
    password           String?
    provider           PROVIDER  @default(LOCAL)
    role               ROLE      @default(ORGANIZATION)
    lastOtp            String?
    lastOtpSendingTime DateTime?
    isDeleted          Boolean   @default(false)
    isAccountVerified  Boolean   @default(false)
    // Password-security-hardening audit. Bumped on every successful password
    // change/reset, embedded in every access token at issue time, checked in
    // auth() middleware (reusing the DB read that check already does for
    // isAccountVerified -- no extra query). A stolen/leaked session token
    // becomes invalid the moment the legitimate account holder changes their
    // password, instead of surviving until natural JWT expiry.
    security_stamp     String    @default(uuid())
    // Bumped on every "forgot password" request (not just successful
    // resets). Embedded in the reset-password JWT at issuance, checked at
    // redemption -- makes reset tokens genuinely single-use (a successful
    // reset also bumps this) and means requesting a new reset link
    // invalidates any still-valid older one, rather than both staying live
    // until their own 5-minute expiry.
    reset_token_stamp  String    @default(uuid())
    createdAt          DateTime  @default(now())
    updatedAt          DateTime  @default(now())

    profile             Profile?
    organizationProfile OrganizationProfile?
    sites               Site[]
    risks               Risk[]
    inspections         Inspection[]
    recommendations     Recommendation[]
    templates           Template[]
    actionMessages      ActionMessage[]
    actions             Action[]
    pineconeDocuments   PineconeDocument[]
    notes               Note[]
    kris                Kri[]
    kriReadings         KriReading[]
    alerts              Alert[]
    notifications       Notification[]
    auditEngagements    AuditEngagement[]
    complianceObligations ComplianceObligation[]
    complianceAttestations ComplianceAttestation[]
    complianceObligationEdits ComplianceObligationEdit[]
    reports             Report[]
    // aexa-frontend#141 stage 2: threat intelligence persistence.
    intelligenceItems IntelligenceItem[]
    intelligenceRuns  IntelligenceRun[]
    // aexa-frontend#142: risk-to-risk correlation links (RiskLink.ref-based
    // design — see risk.prisma's RiskLink comment).
    riskLinks         RiskLink[]
    // design-docs/site-ai-risk-register-generation.md: "Analyze with AI" run
    // provenance records.
    aiRiskAnalysisRuns AiRiskAnalysisRun[]

    // Org membership — nullable/optional since not every account has one
    // until the slice-1 backfill script runs (see src/scripts/backfill-org-membership.ts).
    orgMembership OrgMember?
}
