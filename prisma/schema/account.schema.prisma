enum ROLE {
    ADMIN
    USER
    ORGANIZATION
}

enum PROVIDER {
    LOCAL
    GOOGLE
    FACEBOOK
    GITHUB
    TWITTER
    LINKEDIN
    INSTAGRAM
}

model Account {
    id                 String    @id @default(uuid())
    email              String    @unique
    password           String?
    provider           PROVIDER  @default(LOCAL)
    role               ROLE      @default(ORGANIZATION)
    lastOtp            String?
    lastOtpSendingTime DateTime?
    isDeleted          Boolean   @default(false)
    isAccountVerified  Boolean   @default(false)
    createdAt          DateTime  @default(now())
    updatedAt          DateTime  @default(now())

    profile             Profile?
    organizationProfile OrganizationProfile?
    sites               Site[]
    risks               Risk[]
    inspections         Inspection[]
    recommendations     Recommendation[]
    templates           Template[]
    actionMessages      ActionMessage[]
    actions             Action[]
    pineconeDocuments   PineconeDocument[]
    notes               Note[]
    kris                Kri[]
    kriReadings         KriReading[]
    alerts              Alert[]
    notifications       Notification[]
    auditEngagements    AuditEngagement[]
    complianceObligations ComplianceObligation[]
    complianceAttestations ComplianceAttestation[]
    reports             Report[]
    // aexa-frontend#141 stage 2: threat intelligence persistence.
    intelligenceItems IntelligenceItem[]
    intelligenceRuns  IntelligenceRun[]
    // aexa-frontend#142: risk-to-risk correlation links (RiskLink.ref-based
    // design — see risk.prisma's RiskLink comment).
    riskLinks         RiskLink[]

    // Org membership — nullable/optional since not every account has one
    // until the slice-1 backfill script runs (see src/scripts/backfill-org-membership.ts).
    orgMembership OrgMember?
}
