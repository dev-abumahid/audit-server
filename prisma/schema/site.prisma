// External-data-anchoring plan, Phase 0b (Step 0 sector/identity
// resolution). SIC from SEC EDGAR, NAF from a future Sirene/INSEE
// integration (Decision #3 in the plan is still open -- this value exists
// so a later Sirene integration doesn't need a second migration), ESTIMATED
// when the LLM-fallback tier of the resolution cascade was used. Kept
// distinct from `secteur_code` itself because SEC EDGAR's SIC codes and a
// future Sirene integration's NAF codes are different code spaces --
// sharing one untyped column would silently corrupt lookups once a second
// code type exists.
enum SectorCodeType {
    SIC
    NAF
    ESTIMATED
}

model Site {
    id              String   @id @default(uuid())
    org_account_id  String
    account         Account  @relation(fields: [org_account_id], references: [id], onDelete: Cascade)
    name            String
    location        String?
    country         String?
    activity        String?
    // design-docs/site-ai-risk-register-generation.md §3: the one field the
    // CEO's mockup expected that Site didn't already have. Free text, fed
    // into the AI risk-generation prompt (capped at 2,000 chars server-side
    // before it reaches any prompt -- see the generation service).
    description     String?
    revenue         Int
    employees_count Int
    site_type       String
    lat             Float?
    lng             Float?
    // Trust-labeling for zero-input onboarding (#96), mirroring Risk's
    // existing fields: ai_generated flags a site discovered by the AI
    // pipeline rather than hand-entered, and source_info carries the
    // Tavily-derived discovery citation so a reviewer can verify it.
    ai_generated    Boolean  @default(false)
    source_info     String?
    // External-data-anchoring plan, Phase 0b. Resolved once per site (see
    // aiRiskAnalysis.service.ts's resolveSiteSectorIfNeeded, called at the
    // start of every AI risk analysis run) and cached here -- a site that
    // already has a secteur_code is never re-resolved, avoiding a redundant
    // external call on every regenerate. All three nullable: unresolved
    // until the first AI risk analysis run for this site actually runs the
    // resolution cascade.
    secteur_code       String?
    secteur_code_type  SectorCodeType?
    secteur_estime     Boolean  @default(false)
    // External-data-anchoring plan, Phase 1 (Cyber/IT category). Optional
    // per-site override of the org's OrganizationProfile.organizationWebsite
    // -- a site can genuinely have its own internet-facing footprint
    // distinct from the parent org's corporate site (e.g. a manufacturing
    // plant with its own subdomain, or a subsidiary with its own domain).
    // Resolution order (see aiRiskAnalysis.service.ts's site profile
    // builder): this field first, falling back to the org's
    // organizationWebsite when unset. Deliberately no automated
    // discovery/guessing of this value anywhere -- both this field and the
    // org-level fallback are exclusively user-provided, since a wrong
    // domain here would attribute a real, specific CVE to the wrong
    // company, a materially worse mistake than the softer classification
    // signals (sector code, revenue figure) other Phase 1 sources accept
    // some inference risk on.
    website_domain     String?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    // Relations
    risks           Risk[]
    inspections     Inspection[]
    recommendations Recommendation[]
    action          Action[]
    complianceObligations ComplianceObligation[]
    aiRiskAnalysisRuns AiRiskAnalysisRun[]

    @@index([org_account_id])
}
