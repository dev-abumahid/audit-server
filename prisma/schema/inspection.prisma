enum Status {
    IN_PROGRESS
    COMPLETED
    CANCELLED
    DRAFT
}

model Inspection {
    id String @id @default(uuid())
    // meta key
    orgAccountId       String
    templateId         String
    siteId             String
    inspectorProfileId String?
    riskId             String?

    // main data set
    questionAnswers QuestionAnswer[]
    unSplitText     String?
    // Inspection-level attachments (as opposed to per-question mediaFiles on
    // QuestionAnswer) — see #53. Same S3-upload-then-PATCH-URL-array pattern
    // as Action.attachments.
    attachments     String[]         @default([])

    // Relations
    account   Account  @relation(fields: [orgAccountId], references: [id], onDelete: Cascade)
    template  Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
    site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
    // SetNull, not Cascade: inspectorProfileId is optional metadata (who
    // performed the inspection), not ownership. Deleting a Profile/Account
    // must not destroy the inspection record itself — it should just null out
    // the inspector reference. Found by audit.
    inspector Profile? @relation(fields: [inspectorProfileId], references: [id], onDelete: SetNull)
    risk      Risk?    @relation(fields: [riskId], references: [id], onDelete: Cascade)
    status    Status   @default(IN_PROGRESS)

    // Time State
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    recommendations Recommendation[]
    actions         Action[]
    note            Note?
    assignments     InspectionAssignment[]

    @@index([orgAccountId])
}

model QuestionAnswer {
    id           String @id @default(uuid())
    inspectionId String
    questionId   String

    answer     Json
    note       String?
    mediaFiles Json?

    // Relations
    inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
    question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
}
