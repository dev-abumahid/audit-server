enum TemplateStatus {
    DRAFT
    PUBLISHED
}

model Template {
    id           String  @id @default(uuid())
    orgAccountId String
    templateLogo String?
    templateName String
    templateDisc String?
    riskId       String?
    // quality-bar-loop round 5 (Templates, industry-standards): draft/
    // publish state, addressing the "no publish/draft state or usage
    // tracking" gap -- every reference tool in this category (Typeform,
    // Google Forms, SafetyCulture) distinguishes a half-built template
    // from one that's ready to use. Defaults to PUBLISHED so every
    // existing row (created before this field existed) keeps behaving
    // exactly as it always has -- only the frontend's create flow opts
    // new templates into starting as DRAFT (see CreateTemplatePage.tsx).
    // Enforced at the one place a draft's incompleteness would actually
    // hurt: StartInspectionModal's template picker excludes drafts via
    // GET /template's new `status` filter, so nobody accidentally starts
    // a real inspection against an unfinished checklist. Everywhere else
    // (list, edit, report, duplicate) a draft behaves like any other
    // template -- the goal is to gate usage, not to hide or lock it.
    status       TemplateStatus @default(PUBLISHED)
    // quality-bar-loop round 4 (Templates, industry-standards): free-text
    // category/tag, addressing the "no categories/tagging/folders" gap --
    // every reference tool in this category (SafetyCulture/iAuditor,
    // Typeform, Google Forms) supports at least basic categorization.
    // Deliberately a plain string, not a relational Category model: a
    // full taxonomy (org-level category management, reordering, merging)
    // is a much larger feature than this round's scope, and a free-text
    // field with a suggest-from-existing-values UI (same pattern as
    // AuditPage's lead-auditor <datalist>) covers the common case without
    // it. Nullable/optional so every existing template stays valid.
    category     String?

    pages       Page[]
    access      TemplateAccess[]
    inspections Inspection[]

    account Account @relation(fields: [orgAccountId], references: [id], onDelete: Cascade)
    risk    Risk?   @relation(fields: [riskId], references: [id], onDelete: SetNull)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([orgAccountId])
    @@index([orgAccountId, category])
}

model Page {
    id         String @id @default(uuid())
    templateId String
    pageIndex  Int
    title      String

    template  Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
    questions Question[]

    @@index([templateId, pageIndex])
}

model Question {
    id         String  @id @default(uuid())
    pageId     String
    index      Int
    question   String
    isRequired Boolean

    answerType String
    value      Json

    page            Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
    questionAnswers QuestionAnswer[]
    actions         Action[]

    @@index([pageId, index])
}

model TemplateAccess {
    id         String   @id @default(uuid())
    templateId String
    userId     String
    profile    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
    template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

    @@index([templateId, userId])
}
