# Every var below is read in src/app/configs/index.ts. Keep this file in sync
# with that file — it is the single source of truth for configuration.

# Default Node config
NODE_ENV=development
PORT=5000   # required — must be a valid positive integer or the server won't start

# Database config
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/server_db?sslmode=disable"

# Redis Config
HOSTED_REDIS_CONNECTION=false   # true or false | if true, provide HOSTED_REDIS_DB_URL below
HOSTED_REDIS_DB_URL=
REDIS_HOST=localhost            # used when HOSTED_REDIS_CONNECTION is false
REDIS_PORT=6379                 # used when HOSTED_REDIS_CONNECTION is false

# Session Config
SESSION_SECRET=   # required — server won't start without it (express-session secret)

# JWT Configuration
ACCESS_TOKEN=
ACCESS_EXPIRES=
REFRESH_TOKEN=
REFRESH_EXPIRES=
RESET_SECRET=
RESET_EXPIRES=
VERIFIED_TOKEN=
FRONT_END_URL=http://localhost:5173

# Email Configuration
APP_USER_EMAIL=
APP_PASSWORD=

# AWS S3 Configuration (file uploads — see src/app/utils/cloudinary.ts, which
# despite its filename uses @aws-sdk/client-s3 and these AWS_* vars)
AWS_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Swagger Config
DEVELOPMENT_BASE_URL=
PRODUCTION_BASE_URL=

# AI Service (aexa-ai)
AI_SERVER_ENDPOINT=
AI_INTERNAL_SECRET=   # required — server won't start without it. Must match INTERNAL_SECRET on the aexa-ai side

# Social login — Google (all optional; only read when IS_GOOGLE_LOGIN=true)
IS_GOOGLE_LOGIN=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Social login — Facebook (all optional; only read when IS_FACEBOOK_LOGIN=true)
IS_FACEBOOK_LOGIN=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=

# Social login — Twitter (all optional; only read when IS_TWITTER_LOGIN=true)
IS_TWITTER_LOGIN=false
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_CALLBACK_URL=

# Social login — GitHub (all optional; only read when IS_GITHUB_LOGIN=true)
IS_GITHUB_LOGIN=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
