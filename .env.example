# Default Node config
NODE_ENV=development
PORT=5000

# Database config
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/server_db?sslmode=disable"

# Redis Config
HOSTED_REDIS_CONNECTION=false   # Value will be true or false | If true you need to put Hosted Redis database url
HOSTED_REDIS_DB_URL=


# Session Config
SESSION_SECRET=

# JWT Configuration
ACCESS_TOKEN=
ACCESS_EXPIRES=
RESET_SECRET=
RESET_EXPIRES=
VERIFIED_TOKEN=
FRONT_END_URL=http://localhost:5173

# Email Configuration
APP_USER_EMAIL=
APP_PASSWORD=

# Cloudinary Configuration
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Swagger Config
DEVELOPMENT_BASE_URL=
PRODUCTION_BASE_URL=

# AI Service (aexa-ai)
AI_SERVER_ENDPOINT=
AI_INTERNAL_SECRET=   # required — server won't start without it. Must match INTERNAL_SECRET on the aexa-ai side