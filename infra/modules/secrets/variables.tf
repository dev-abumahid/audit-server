variable "project" {
  type = string
}

variable "db_endpoint" {
  type = string
}

variable "db_port" {
  type = number
}

variable "db_name" {
  type = string
}

variable "db_username" {
  type = string
}

variable "db_password" {
  type      = string
  sensitive = true
}

variable "redis_endpoint" {
  type = string
}

variable "redis_port" {
  type = number
}

variable "redis_auth_token" {
  type      = string
  sensitive = true
}

# Values with no Terraform-generated source (JWT secrets, OAuth client
# secrets, APP_PASSWORD, S3 keys, AI_INTERNAL_SECRET) -- entered out-of-band
# via a *.auto.tfvars file that is gitignored (see infra/.gitignore) and
# never committed. terraform.tfvars.example documents the required keys.
variable "app_secrets" {
  description = "Map of app-level secret values not generated by Terraform (JWT signing secrets, OAuth client secrets, APP_PASSWORD, AI_INTERNAL_SECRET)."
  type        = map(string)
  sensitive   = true
}

variable "aws_s3_access_key_id" {
  type      = string
  sensitive = true
}

variable "aws_s3_secret_access_key" {
  type      = string
  sensitive = true
}
