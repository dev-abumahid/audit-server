variable "aws_region" {
  description = "AWS region for all resources."
  type        = string
  default     = "us-east-1"
}

variable "project" {
  description = "Short project name used in resource naming."
  type        = string
  default     = "aexa-server"
}

variable "app_port" {
  description = "Port aexa-server listens on inside the container. Dockerfile EXPOSEs 5002, matching the live VPS .env's PORT value."
  type        = number
  default     = 5002
}

variable "domain_name" {
  type    = string
  default = "api.qiyrix.com"
}

variable "app_secrets" {
  description = "Map of app-level secret values not generated by Terraform (JWT signing secrets, OAuth client secrets, APP_PASSWORD, AI_INTERNAL_SECRET). Supplied via terraform.auto.tfvars (gitignored)."
  type        = map(string)
  sensitive   = true
}

variable "aws_s3_access_key_id" {
  type      = string
  sensitive = true
}

variable "aws_s3_secret_access_key" {
  type      = string
  sensitive = true
}
